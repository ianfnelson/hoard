<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <UserSecretsId>59768fb3-7283-4a0e-87d6-ffc3b56f538c</UserSecretsId>
    </PropertyGroup>

    <ItemGroup>
      <FrameworkReference Include="Microsoft.AspNetCore.App" />
    </ItemGroup>

    <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
      <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    </PropertyGroup>

    <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
      <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    </PropertyGroup>

    <PropertyGroup>
      <MigrationsDirectory>Data/Migrations</MigrationsDirectory>
    </PropertyGroup>

    <ItemGroup>
      <InternalsVisibleTo Include="Hoard.Test" />
    </ItemGroup>

    <!-- Transitive pins: Clarion and Microsoft.Data.SqlClient reference versions with known vulnerabilities. -->
    <ItemGroup>
      <PackageReference Include="AngleSharp" Version="1.8.5" />
      <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="Azure.Storage.Blobs" Version="12.30.1" />
      <PackageReference Include="Clarion" Version="1.1.0" />
      <PackageReference Include="ExcelFinancialFunctions" Version="3.2.0" />
      <PackageReference Include="FluentValidation" Version="12.2.0" />
      <PackageReference Include="FluentValidation.DependencyInjectionExtensions" Version="12.2.0" />
      <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.13" />
      <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.13">
        <PrivateAssets>all</PrivateAssets>
        <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      </PackageReference>
      <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.13" />
      <PackageReference Include="Rebus" Version="8.9.5" />
      <PackageReference Include="Rebus.RabbitMq" Version="10.1.2" />
      <PackageReference Include="Rebus.ServiceProvider" Version="10.7.2" />
      <PackageReference Include="Rebus.SqlServer" Version="8.4.2" />
      <PackageReference Include="Scrutor" Version="7.0.0" />
      <PackageReference Include="QuestPDF" Version="2026.9.1" />
      <PackageReference Include="YahooFinanceApiNext" Version="2.3.11" />
    </ItemGroup>

    <ItemGroup>
      <EmbeddedResource Include="Infrastructure\Integrations\Fonts\*.ttf" />
    </ItemGroup>

    <ItemGroup>
      <Folder Include="Data\Migrations\" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\Hoard.Messages\Hoard.Messages.csproj" />
    </ItemGroup>
</Project>
